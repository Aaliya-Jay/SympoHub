NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/sympohub
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# Optional SMTP configuration. RSVP responses do not wait for email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=SympoHub <no-reply@example.com>

# Seed script demo credentials (use only for local development)
SEED_ADMIN_EMAIL=admin@sympohub.edu
SEED_ADMIN_PASSWORD=Admin@12345
SEED_STUDENT_EMAIL=student@sympohub.edu
SEED_STUDENT_PASSWORD=Student@12345
